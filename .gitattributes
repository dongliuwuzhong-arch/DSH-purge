# 行尾统一：仓库里一律 LF，检出也一律 LF。
#
# 不加这份文件时，行尾由全局 core.autocrlf=true 决定（见
# ~/.dsh/dsh-ops/shells/bash/2.56.0.2/etc/gitconfig），于是：
#   仓库 blob = LF，工作区 = CRLF，profile 里的运行副本 = LF。
# 同一个文件三处三种字节长度，任何「源码与运行副本是否同步」的比对都会假报不同步，
# 而 hashOverride() 又靠 normalizeOverride() 把 CR 悄悄归一才没炸 —— 别再靠这个巧合。
* text=auto eol=lf

# 真二进制：禁止任何 text 归一，否则图片会被 LF 转换弄坏，diff/merge 也会错。
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg text eol=lf
*.zip binary
*.tgz binary
*.asar binary
*.node binary
# 本机预检基线不进任何分发物（GitHub 的 main.tar.gz 也走 export-ignore）
scripts/preflight-baseline.json export-ignore

# 开发期的 *.before.js 快照（V15 收 · F2）：1.5.0 误提交过 _tmp/（211 KB，含 1.4.x 补丁表全文），
# tar 与 zip 都带出去了。package.json 的 files 白名单只管 npm tarball；git archive 那条通道
# 只认这里的 export-ignore。第三条保险是 release.yml 的 zip 内容断言。
_tmp/** export-ignore

# 第三方微信截图（docs/notice，零引用，243,971 B）：只留在仓库，不进任何分发物。
# GitHub 的 main.tar.gz / main.zip 走 git archive，那条通道只认这里的 export-ignore；
# npm tarball 走 package.json files 里的 "!docs/notice"；release zip 由 release.yml 的
# "assert zip content" 兜底断言（出现了就红，不静默剔）。三条通道各管一段，别只改一处。
docs/notice/** export-ignore
