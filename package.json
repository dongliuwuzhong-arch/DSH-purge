{
  "name": "dsh-purge",
  "version": "1.2.2",
  "description": "DeepSeek Harness 0.2.1 系列兼容的提示词与宿主补丁插件：管理注入、规则集与 Skill，支持补丁应用/还原、密封 asar 自愈、会话回退和网络范围白名单。基于 YuJunZhiXue/dsh-purge 上游维护。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-purge": "bin/dsh-purge.js"
  },
  "files": [
    "lib",
    "!lib/*.bak*",
    "bin",
    "docs",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "COMPAT-0.2.1.md",
    "LICENSE"
  ],
  "scripts": {
    "install:offline": "node scripts/install-offline.mjs",
    "install:verify": "node scripts/install-offline.mjs --verify",
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "sync-runtime": "node scripts/sync-runtime.mjs --apply",
    "sync-runtime:check": "node scripts/sync-runtime.mjs",
    "assert-patches": "node scripts/assert-patches.mjs"
  },
  "license": "MIT",
  "author": "dongliuwuzhong-arch",
  "contributors": [
    {
      "name": "YuJunZhiXue",
      "url": "https://github.com/YuJunZhiXue/dsh-purge"
    }
  ],
  "upstream": {
    "name": "YuJunZhiXue/dsh-purge",
    "url": "https://github.com/YuJunZhiXue/dsh-purge",
    "license": "MIT"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "prompt-injection",
    "host-patch",
    "rules",
    "skills",
    "desktop",
    "web"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dongliuwuzhong-arch/DSH-purge.git"
  },
  "homepage": "https://github.com/dongliuwuzhong-arch/DSH-purge#readme",
  "bugs": {
    "url": "https://github.com/dongliuwuzhong-arch/DSH-purge/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://github.com/dongliuwuzhong-arch/DSH-purge/archive/refs/heads/main.tar.gz",
      "zip": "https://github.com/dongliuwuzhong-arch/DSH-purge/archive/refs/heads/main.zip",
      "git": "https://github.com/dongliuwuzhong-arch/DSH-purge.git"
    },
    "version": "1.2.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dshTarget": "0.2.1-rc.5"
}
